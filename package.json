{
  "name": "filefinder",
  "version": "1.0.1",
  "description": "Simple family file search",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/set-dev-icon.js && electron .",
    "postinstall": "node scripts/set-dev-icon.js",
    "build:rust": "cargo build --release --manifest-path searcher/Cargo.toml",
    "dist": "npm run build:rust && electron-builder --win"
  },
  "build": {
    "appId": "com.brunolm.filefinder",
    "productName": "File Finder",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "searcher/target/release/searcher.exe",
        "to": "searcher.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}
